# Copy this to .env.local (gitignored) and fill in real values.
# app.py auto-loads .env.local on startup.

# Each *_API_KEY gates a feature panel in the Subtitle Burner UI.
# Missing/empty key -> the panel disappears. Verify in DevTools by checking
# whether the {% if X_enabled %} block in templates/index.html rendered.

GEMINI_API_KEY=        # ✨ Highlights + 🎞 Compilation suggestions (Google AI Studio)
AUPHONIC_API_KEY=      # ⚡ Auphonic AI audio enhancement
ELEVENLABS_API_KEY=    # 🎙 ElevenLabs Voice Isolator
DOLBY_API_KEY=         # 🎚 Dolby.io audio enhancement

# B-roll / stock photos (Timeline → Media → Suggest B-roll)
# Prefer exact name PEXELS_API_KEY (aliases PEXELS_KEY / PEXELS_API also work).
# Cursor Environment Secrets do NOT sync to Replit — set them on each host.
# After changing Replit Secrets: Stop + Run (or Redeploy). Check /broll/status?probe=1
PEXELS_API_KEY=              # https://www.pexels.com/api/
UNSPLASH_ACCESS_KEY=         # https://unsplash.com/developers
GOOGLE_CSE_API_KEY=          # Google Cloud API key with Custom Search API enabled
GOOGLE_CSE_CX=               # Programmable Search Engine id (cx=… from embed snippet)

# Speaker diarization / 9:16 reframe (Analyze button — NOT run on upload)
# Same Hugging Face account must accept ALL gated repos (newer pyannote pulls
# community-1 assets even when DIARIZATION_MODEL is still 3.1):
#   1) https://huggingface.co/pyannote/speaker-diarization-3.1
#   2) https://huggingface.co/pyannote/segmentation-3.0
#   3) https://huggingface.co/pyannote/speaker-diarization-community-1
#   4) Create a token: https://huggingface.co/settings/tokens
#      Classic "Read" token works, OR fine-grained with
#      "Read access to contents of all public gated repos you can access"
#   5) Paste below and RESTART the Studio server (Secrets on Replit: Stop+Run)
HF_TOKEN=
# Optional override if you want the newer pipeline explicitly:
# DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
# Optional: preload pyannote at boot (slows first uploads) — leave off
# DIARIZATION_WARM=0

# auto = CUDA if present, else Apple MPS, else CPU (recommended)
DIARIZATION_DEVICE=auto
# Optional CPU parallelism on Linux (ignored on macOS for stability):
# DIARIZATION_TORCH_THREADS=8
# Optional: lower = faster face pass during Analyze (default 2)
# REFRAME_FACE_SAMPLE_FPS=2

# Stripe (used elsewhere in the project, not by the burner)
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
