# Copy this to .env.local (gitignored) and fill in real values.
# app.py auto-loads .env.local on startup.

# Each *_API_KEY gates a feature panel in the Subtitle Burner UI.
# Missing/empty key -> the panel disappears. Verify in DevTools by checking
# whether the {% if X_enabled %} block in templates/index.html rendered.

GEMINI_API_KEY=        # ✨ Highlights + 🎞 Compilation suggestions (Google AI Studio)
AUPHONIC_API_KEY=      # ⚡ Auphonic AI audio enhancement
ELEVENLABS_API_KEY=    # 🎙 ElevenLabs Voice Isolator
DOLBY_API_KEY=         # 🎚 Dolby.io audio enhancement

# Speaker diarization / 9:16 reframe (Analyze button)
# Free token: https://huggingface.co/settings/tokens
# Also accept licences:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=

# auto = CUDA if present, else Apple MPS, else CPU (recommended)
DIARIZATION_DEVICE=auto
# Optional CPU parallelism on Linux (ignored on macOS for stability):
# DIARIZATION_TORCH_THREADS=8
# Optional: lower = faster face pass during Analyze (default 2)
# REFRAME_FACE_SAMPLE_FPS=2

# Stripe (used elsewhere in the project, not by the burner)
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
