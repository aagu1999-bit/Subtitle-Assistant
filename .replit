modules = ["nodejs-24", "python-3.11"]

[deployment]
router = "application"
# Reserved VM, not autoscale. The burner keeps uploads, rendered MP4s and its
# SQLite job database on local disk, so it needs one machine with a filesystem
# that survives: on autoscale the disk is ephemeral and requests spread across
# instances, so an upload handled by one instance is invisible to the next.
deploymentTarget = "gce"
# Gunicorn rather than Flask's development server, with a single worker
# because job state lives in memory in the serving process — a second worker
# would answer /status for jobs it has never heard of. Threads give the
# concurrency instead. Renders take minutes, so the worker timeout is off;
# with the default 30s gunicorn would kill the worker mid-encode.
run = ["sh", "-c", "cd artifacts/subtitle-burner && gunicorn --workers 1 --threads 8 --timeout 0 --bind 0.0.0.0:${PORT:-8081} app:app"]

[deployment.postBuild]
# Remotion needs two things this step never provided, so the 42 Remotion
# recipes have been falling through to motion.py's freehand designer on the
# deploy -- silently, because _make_animation catches every exception.
#
#   1. node_modules. Gitignored, and the only thing that installed it was
#      scripts/post-merge.sh, which runs on an agent merge and not on a
#      deployment build.
#   2. The Chrome headless shell Remotion renders in (~176MB, fetched from
#      remotion.media into node_modules/.remotion). NOTHING in this repo has
#      ever fetched it. Doing it here means the first render does not pay for
#      it, and does not fail if egress to remotion.media is closed at runtime.
#
# `store prune` stays last: pruning before the install would make the install
# re-download everything.
#
# Deliberately NOT in scripts/post-merge.sh: [postMerge] has timeoutMs = 20000
# and a 176MB download would blow it, which would kill the app restart at the
# end of that script.
#
# The browser fetch is non-fatal on purpose. The install must succeed -- a
# lockfile mismatch should stop the deploy -- but a hiccup reaching
# remotion.media must not, or a CDN blip takes the whole app down to buy a
# cache warm-up. Without it the first render tries the fetch itself, which is
# exactly today's behaviour.
args = ["sh", "-c", "pnpm install --frozen-lockfile && (cd artifacts/remotion-overlays && pnpm exec remotion browser ensure || echo 'WARN: could not pre-fetch the Remotion browser; the first render will retry') && pnpm store prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace/artifacts/subtitle-burner && PORT=8081 python app.py"
waitForPort = 8081

[[workflows.workflow]]
name = "artifacts/api-server: API Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "3B4_FFSkEVBkAeYMFRJ2e"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev"
cwd = "./artifacts/api-server"
waitForPort = 8080
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8080"

[[workflows.workflow]]
name = "artifacts/mockup-sandbox: Component Preview Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "XegfDyZt7HqfW2Bb8Ghoy"
isCanvasWorkflow = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mockup-sandbox run dev"
cwd = "./artifacts/mockup-sandbox"
waitForPort = 8082
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8082"
BASE_PATH = "/__mockup"

[[workflows.workflow]]
name = "Remotion Studio"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace/artifacts/remotion-overlays && pnpm remotion studio --no-open --ipv4 --port 8000 --disable-git-source"
waitForPort = 8000

[[workflows.workflow]]
name = "Hyperframes Studio"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace/artifacts/hyperframes-overlays && npx --yes hyperframes@0.9.88 preview --no-open --port 8001 --foreground"
waitForPort = 8001

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/api-server: API Server"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 8001
externalPort = 8001

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3000

[[ports]]
localPort = 8083
externalPort = 3002

[nix]
channel = "stable-25_05"
